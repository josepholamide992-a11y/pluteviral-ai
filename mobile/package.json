{
  "name": "pluteviral-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "test:ui": "playwright test",
    "test:core": "tsc --target es2022 --module commonjs --strict --lib es2022,dom --outDir .core-test-build src/content.ts src/api.ts && node --test tests/core.test.cjs",
    "build:web": "expo export -p web"
  },
  "dependencies": {
    "expo": "~57.0.17",
    "expo-file-system": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.24",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "expo-sqlite": "~57.0.1",
    "react-dom": "19.2.3",
    "react-native-web": "~0.21.0",
    "@expo/metro-runtime": "~57.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "@playwright/test": "^1.58.0"
  }
}
